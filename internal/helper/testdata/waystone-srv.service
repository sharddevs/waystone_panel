# Managed by Waystone. Do not edit: provisioning rewrites this file.
[Unit]
Description=Waystone game server 3f2504e0-4f89-41d3-9a0c-0305e82c3301
Wants=network-online.target
After=network-online.target waystone-srv-3f2504e0-4f89-41d3-9a0c-0305e82c3301-console.socket
# The console FIFO (7b) comes up with every start and goes with every stop.
Requires=waystone-srv-3f2504e0-4f89-41d3-9a0c-0305e82c3301-console.socket

[Service]
Type=simple
User=ws-16362f566387
Group=ws-16362f566387
# systemd creates /var/lib/waystone/servers/<id> on first start, owned by
# User= with mode 0750. Nothing in Waystone chowns it as root.
StateDirectory=waystone/servers/3f2504e0-4f89-41d3-9a0c-0305e82c3301
StateDirectoryMode=0750
WorkingDirectory=/var/lib/waystone/servers/3f2504e0-4f89-41d3-9a0c-0305e82c3301
ExecStart=/usr/lib/jvm/java-25-openjdk-amd64/bin/java -Xms2048M -Xmx2048M -jar server.jar nogui
# Console commands arrive on stdin from the console socket's FIFO. Output
# still goes to the journal, which is where the log is read from (7a).
Sockets=waystone-srv-3f2504e0-4f89-41d3-9a0c-0305e82c3301-console.socket
StandardInput=socket
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
# Java exits with 143 when systemd stops it with SIGTERM. That is a stop,
# not a failure.
SuccessExitStatus=143
# The heap plus room for the JVM itself.
MemoryMax=3072M
UMask=0027

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
