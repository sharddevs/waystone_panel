# SPDX-License-Identifier: AGPL-3.0-only
# Copy to /etc/waystone/controller.env (root:root 0644). No secrets go
# here. Read by waystone-controller.service.
#
# The agent's uid: id -u waystone-agent
WAYSTONE_AGENT_UID=
# The node this controller's agent speaks for (UUID from the nodes table)
WAYSTONE_NODE_ID=
# The canonical public URL browsers use: https only, no path. Requests
# for any other host are refused.
WAYSTONE_PUBLIC_URL=
# The reverse proxy's uid (id -u caddy): the only user web.sock accepts
WAYSTONE_PROXY_UID=
# Optional: HSTS max-age in seconds (default 300). Raise it once HTTPS is
# known to work; at most 63072000.
#WAYSTONE_HSTS_MAX_AGE=300
