# The agent runs as waystone-agent, never as root. It connects out to the
# controller's agent socket, the helper and the provisioning service;
# losing any of them is not fatal, it reconnects. Restart= only covers a
# crash.
[Unit]
Description=Waystone agent
Wants=waystone-helper.socket waystone-provisioner.socket waystone-controller-agent.socket
After=waystone-helper.socket waystone-provisioner.socket waystone-controller-agent.socket

[Service]
Type=simple
User=waystone-agent
Group=waystone-agent
EnvironmentFile=/etc/waystone/agent.env
ExecStart=/usr/local/bin/waystone-agent -controller /run/waystone-controller/agent.sock -controller-uid ${WAYSTONE_CONTROLLER_UID} -node ${WAYSTONE_NODE_ID} -provisioner /run/waystone-provisioner/provisioner.sock
# An install's jar waits in staging/ between the controller and the
# provisioner (6c-2). Nothing else here is writable.
StateDirectory=waystone-agent waystone-agent/staging
StateDirectoryMode=0700
Restart=always
RestartSec=2

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Loopback only (4d-2): the readiness probe pings the game on 127.0.0.1.
# The kernel filter drops every other address.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
