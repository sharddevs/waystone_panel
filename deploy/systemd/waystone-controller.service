# SPDX-License-Identifier: AGPL-3.0-only
# The controller runs as its own unprivileged user and is started by its
# sockets: the local API, the browser-facing web socket and the agent's.
# It refuses to run unless systemd passes exactly those three, so Sockets=
# names them. WAYSTONE_HSTS_MAX_AGE has a default here; controller.env may
# override it. Agents on other machines need one more socket, the TCP
# listener; the agent-tcp drop-in adds it (stage 6a). Even then this
# process keeps PrivateNetwork and AF_UNIX: it accepts on the socket
# systemd opened and never opens one itself. Schema migrations are not
# run from here: they
# are a manual step as waystone_owner, and this user only ever gets
# waystone_app.
[Unit]
Description=Waystone controller
Requires=waystone-controller-api.socket waystone-controller-web.socket waystone-controller-agent.socket
After=waystone-controller-api.socket waystone-controller-web.socket waystone-controller-agent.socket postgresql.service

[Service]
Type=simple
User=waystone-controller
Group=waystone-controller
Environment=WAYSTONE_HSTS_MAX_AGE=300
EnvironmentFile=/etc/waystone/controller.env
ExecStart=/usr/local/bin/waystone-controller -agent-uid ${WAYSTONE_AGENT_UID} -agent-node ${WAYSTONE_NODE_ID} -public-url ${WAYSTONE_PUBLIC_URL} -proxy-uid ${WAYSTONE_PROXY_UID} -hsts-max-age ${WAYSTONE_HSTS_MAX_AGE}
Sockets=waystone-controller-api.socket waystone-controller-web.socket waystone-controller-agent.socket
# The agent link's key (6a): /var/lib/waystone-controller/agent-tls. The
# pinned jars an install serves (6c-2): .../artifacts, one file per SHA-256.
StateDirectory=waystone-controller waystone-controller/artifacts
StateDirectoryMode=0700
# A jar it doesn't have comes from waystone-fetch@.service (6c-3), which
# leaves it in /var/lib/waystone-fetch, readable by this group only. The
# controller asks on /run/waystone-fetch/fetch.sock (group
# waystone-controller) and copies the file after checking it.
SupplementaryGroups=waystone-fetch
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
